      }

      bindEvents() {
        window.addEventListener('resize', () => this.resize());

        window.addEventListener('keydown', (e) => {
          if (e.code === 'ArrowLeft' || e.code === 'KeyA') this.input.left = true;
          if (e.code === 'ArrowRight' || e.code === 'KeyD') this.input.right = true;
          if (e.code === 'Space') { this.input.fire = true; e.preventDefault(); }
          if (e.code === 'KeyC') this.player.triggerBomb();
          if (e.code === 'Escape' || e.code === 'KeyP') this.togglePause();
        });

        window.addEventListener('keyup', (e) => {
          if (e.code === 'ArrowLeft' || e.code === 'KeyA') this.input.left = false;
          if (e.code === 'ArrowRight' || e.code === 'KeyD') this.input.right = false;
          if (e.code === 'Space') this.input.fire = false;
        });

        const btnL = document.getElementById('btn-left');
        const btnR = document.getElementById('btn-right');
        const btnF = document.getElementById('btn-fire');
        const btnB = document.getElementById('btn-bomb');

        const bindTouch = (elem, startFn, endFn) => {
          elem.addEventListener('touchstart', (e) => { e.preventDefault(); startFn(); }, { passive: false });
          elem.addEventListener('touchend', (e) => { e.preventDefault(); endFn(); }, { passive: false });
        };

        bindTouch(btnL, () => this.input.left = true, () => this.input.left = false);
        bindTouch(btnR, () => this.input.right = true, () => this.input.right = false);
        bindTouch(btnF, () => this.input.fire = true, () => this.input.fire = false);
        btnB.addEventListener('touchstart', (e) => { e.preventDefault(); this.player.triggerBomb(); });

        this.launchBtn.addEventListener('click', () => this.bootFlight());
        this.resumeBtn.addEventListener('click', () => this.togglePause());
        this.rebootBtn.addEventListener('click', () => this.bootFlight());
        this.restartPauseBtn.addEventListener('click', () => this.bootFlight());
        this.pauseTrigger.addEventListener('click', () => this.togglePause());
      }

