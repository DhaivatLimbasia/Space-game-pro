<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>CYBER NOVA // PRO HYPERDRIVE EDITION</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #020208;
      --panel-glass: rgba(8, 12, 28, 0.88);
      --cyan: #00f3ff;
      --magenta: #ff0055;
      --purple: #9d00ff;
      --gold: #ffbe0b;
      --emerald: #05ffa1;
      --orange: #ff5e00;
      --font-display: 'Orbitron', monospace, sans-serif;
      --font-ui: 'Rajdhani', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #000;
      font-family: var(--font-ui);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #cabinet-wrapper {
      position: relative;
      width: 100vw;
      height: 100vh;
      max-width: 860px;
      max-height: 1080px;
      overflow: hidden;
      box-shadow: 0 0 60px rgba(0, 243, 255, 0.22), inset 0 0 30px rgba(0, 0, 0, 0.95);
      border: 1px solid rgba(0, 243, 255, 0.3);
      transition: background 2.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* 4 Distinct Neon-Infused Deep Space Sectors (Cycle every 15s) */
    .sector-env-0 {
      /* Synthwave Neon Grid & Cyan Rift */
      background:
        linear-gradient(rgba(0, 243, 255, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 243, 255, 0.1) 1px, transparent 1px),
        radial-gradient(ellipse at 50% 20%, #150036 0%, #06021f 50%, #010008 100%);
      background-size: 40px 40px, 40px 40px, 100% 100%;
    }
    .sector-env-1 {
      /* Plasma Cyber-Supernova (Magenta & Hot Neon Flame) */
      background:
        radial-gradient(circle at 80% 20%, rgba(255, 0, 85, 0.35) 0%, transparent 50%),
        radial-gradient(circle at 20% 80%, rgba(255, 94, 0, 0.25) 0%, transparent 60%),
        radial-gradient(ellipse at 50% 50%, #29001b 0%, #12010e 55%, #030004 100%);
    }
    .sector-env-2 {
      /* Matrix Hyper-Borealis (Emerald & Acid Teal Web) */
      background:
        linear-gradient(rgba(5, 255, 161, 0.08) 2px, transparent 2px),
        linear-gradient(90deg, rgba(5, 255, 161, 0.08) 2px, transparent 2px),
        radial-gradient(ellipse at 50% 70%, #02382c 0%, #011c19 50%, #000806 100%);
      background-size: 60px 60px, 60px 60px, 100% 100%;
    }
    .sector-env-3 {
      /* Singularity Ultraviolet Void & Event Horizon */
      background:
        radial-gradient(circle at 50% 50%, rgba(157, 0, 255, 0.35) 0%, transparent 45%),
        radial-gradient(circle at 50% 30%, rgba(0, 243, 255, 0.2) 0%, transparent 55%),
        radial-gradient(ellipse at 50% 50%, #20003b 0%, #090017 60%, #010005 100%);
    }

    #cabinet-wrapper::after {
      content: " ";
      position: absolute;
      inset: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%);
      background-size: 100% 4px;
      z-index: 8;
      pointer-events: none;
      opacity: 0.6;
    }

    canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    #nebula-canvas { z-index: 1; }
    #stars-canvas  { z-index: 2; }
    #game-canvas   { z-index: 3; }

    #hud {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      padding: 0.85rem 1.4rem;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1.6fr auto;
      gap: 12px;
      align-items: center;
      z-index: 10;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(3, 5, 15, 0.95) 0%, rgba(3, 5, 15, 0.6) 80%, transparent 100%);
    }

    .hud-box { display: flex; flex-direction: column; }
    .hud-tag {
      font-family: var(--font-display);
      font-size: 0.62rem;
      letter-spacing: 1.5px;
      color: #798ba3;
      font-weight: 700;
    }

    .hud-num {
      font-family: var(--font-display);
      font-size: 1.18rem;
      font-weight: 800;
      line-height: 1.1;
    }

    .glow-cyan { color: var(--cyan); text-shadow: 0 0 10px rgba(0, 243, 255, 0.7); }
    .glow-gold { color: var(--gold); text-shadow: 0 0 10px rgba(255, 190, 11, 0.7); }
    .glow-purple { color: var(--purple); text-shadow: 0 0 10px rgba(157, 0, 255, 0.7); }
    .glow-emerald { color: var(--emerald); text-shadow: 0 0 10px rgba(5, 255, 161, 0.7); }

    .health-module { width: 100%; }
    .health-stats {
      display: flex;
      justify-content: space-between;
      margin-bottom: 3px;
      font-family: var(--font-display);
      font-size: 0.72rem;
    }

    .meter-rail {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.18);
    }

    #health-bar {
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, #ff0055 0%, #ffbe0b 50%, #05ffa1 100%);
      transition: width 0.22s cubic-bezier(0.1, 0.9, 0.2, 1);
      box-shadow: 0 0 8px var(--emerald);
    }

    #bomb-meter-wrap {
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    #bomb-bar {
      height: 4px;
      width: 0%;
      background: linear-gradient(90deg, #9d00ff, #00f3ff);
      box-shadow: 0 0 6px var(--cyan);
      border-radius: 2px;
      transition: width 0.15s ease;
    }

    .btn-hud {
      pointer-events: auto;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      width: 38px;
      height: 38px;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .btn-hud:hover {
      background: rgba(0, 243, 255, 0.25);
      border-color: var(--cyan);
      box-shadow: 0 0 12px var(--cyan);
    }

    #badge-tray {
      position: absolute;
      top: 80px;
      left: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      z-index: 10;
      pointer-events: none;
    }

    .badge-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(8, 12, 28, 0.88);
      border: 1px solid currentColor;
      padding: 4px 12px;
      border-radius: 20px;
      font-family: var(--font-display);
      font-size: 0.68rem;
      letter-spacing: 1.2px;
      animation: popBadge 0.2s ease-out;
      box-shadow: 0 0 12px currentColor;
    }
    @keyframes popBadge { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    .overlay-curtain {
      position: absolute;
      inset: 0;
      background: rgba(2, 3, 10, 0.88);
      backdrop-filter: blur(10px);
      z-index: 50;
      display: none;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .overlay-curtain.active { display: flex; opacity: 1; }

    .glass-slate {
      width: 92%;
      max-width: 500px;
      background: var(--panel-glass);
      padding: 2.2rem;
      border-radius: 16px;
      text-align: center;
      border: 1px solid rgba(0, 243, 255, 0.4);
      box-shadow: 0 0 45px rgba(0, 243, 255, 0.2);
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: 2.6rem;
      font-weight: 900;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-shadow: 0 0 25px rgba(0, 243, 255, 0.8);
    }
    .hero-sub {
      font-size: 0.85rem;
      letter-spacing: 4px;
      color: #92a4bf;
      margin-top: 4px;
      font-weight: 700;
    }

    .briefing {
      margin: 1.4rem 0;
      background: rgba(255, 255, 255, 0.03);
      border-left: 3px solid var(--cyan);
      padding: 0.9rem;
      font-size: 0.88rem;
      color: #cad5e3;
      text-align: left;
      line-height: 1.5;
    }

    .key-capsule {
      margin-top: 8px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      font-size: 0.78rem;
      color: #8c9eb5;
    }

    kbd {
      background: #182035;
      border: 1px solid #3d4f6d;
      border-radius: 4px;
      padding: 2px 6px;
      color: #e2e8f0;
      font-family: var(--font-display);
    }

    .cta-btn {
      font-family: var(--font-display);
      border: none;
      cursor: pointer;
      width: 100%;
      padding: 0.95rem 1.6rem;
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: 2px;
      background: var(--cyan);
      color: #030814;
      clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
      transition: all 0.2s;
    }
    .cta-btn:hover { background: #fff; box-shadow: 0 0 30px var(--cyan); transform: translateY(-2px); }
    .cta-btn:active { transform: scale(0.97); }

    .secondary-btn { background: transparent; color: #fff; border: 1px solid var(--purple); }
    .secondary-btn:hover { background: rgba(157, 0, 255, 0.3); box-shadow: 0 0 20px var(--purple); }

    .danger-btn { background: transparent; color: #fff; border: 1px solid var(--magenta); }
    .danger-btn:hover { background: rgba(255, 0, 85, 0.3); box-shadow: 0 0 20px var(--magenta); }

    .best-banner {
      display: inline-block;
      margin-bottom: 0.6rem;
      padding: 5px 18px;
      background: rgba(255, 190, 11, 0.2);
      border: 1px solid var(--gold);
      border-radius: 12px;
      color: var(--gold);
      font-family: var(--font-display);
      font-size: 0.88rem;
      font-weight: 900;
      letter-spacing: 2px;
      box-shadow: 0 0 20px rgba(255, 190, 11, 0.6);
      animation: pulseScore 1s infinite alternate;
    }
    @keyframes pulseScore { from { transform: scale(0.96); } to { transform: scale(1.05); } }

    .appreciation-card {
      margin-bottom: 1rem;
      background: rgba(5, 255, 161, 0.08);
      border: 1px solid var(--emerald);
      border-radius: 8px;
      padding: 0.8rem 1rem;
      color: var(--emerald);
      font-family: var(--font-ui);
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-shadow: 0 0 12px rgba(5, 255, 161, 0.6);
      animation: fadeUp 0.4s ease;
    }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .score-matrix {
      display: flex;
      justify-content: space-around;
      margin: 1.2rem 0 1.6rem;
      background: rgba(0, 0, 0, 0.5);
      padding: 0.9rem;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    #mobile-controls {
      position: absolute;
      bottom: 14px;
      left: 0;
      width: 100%;
      padding: 0 1.2rem;
      display: none;
      justify-content: space-between;
      align-items: center;
      z-index: 20;
      pointer-events: none;
    }

    .dpad-cluster, .action-cluster {
      display: flex;
      gap: 10px;
      pointer-events: auto;
    }

    .pad-btn {
      background: rgba(12, 18, 38, 0.75);
      border: 1px solid rgba(0, 243, 255, 0.35);
      color: #fff;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      font-family: var(--font-display);
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      touch-action: manipulation;
    }
    .pad-btn:active { background: rgba(0, 243, 255, 0.4); transform: scale(0.92); }

    .bomb-trigger {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      border-color: var(--purple);
      background: rgba(157, 0, 255, 0.25);
      font-size: 0.8rem;
      font-weight: 800;
      color: #d896ff;
    }
    .bomb-trigger:active { background: var(--purple); }

    .fire-trigger {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      border-color: var(--magenta);
      background: rgba(255, 0, 85, 0.3);
      font-size: 1rem;
      font-weight: 800;
      color: #fff;
    }
    .fire-trigger:active { background: var(--magenta); transform: scale(0.92); }

    @media (hover: none) and (pointer: coarse), (max-width: 768px) {
      #mobile-controls { display: flex; }
    }
  </style>
</head>
<body>
  <div id="cabinet-wrapper" class="sector-env-0">
    <canvas id="nebula-canvas"></canvas>
    <canvas id="stars-canvas"></canvas>
    <canvas id="game-canvas"></canvas>

    <header id="hud">
      <div class="hud-box">
        <span class="hud-tag">SCORE</span>
        <span id="score-readout" class="hud-num glow-cyan">0</span>
      </div>
      <div class="hud-box">
        <span class="hud-tag">HIGH SCORE</span>
        <span id="high-score-readout" class="hud-num glow-gold">0</span>
      </div>
      <div class="hud-box">
        <span class="hud-tag">SECTOR</span>
        <span id="sector-readout" class="hud-num glow-purple">1</span>
      </div>
      <div class="hud-box health-module">
        <div class="health-stats">
          <span class="hud-tag">HULL INTEGRITY</span>
          <span id="hp-counter" class="glow-emerald">100 / 100</span>
        </div>
        <div class="meter-rail">
          <div id="health-bar"></div>
        </div>
        <div id="bomb-meter-wrap">
          <span class="hud-tag" style="font-size:0.55rem; color:#bf82ff;">EMP BOMB</span>
          <div class="meter-rail" style="height:4px; flex:1;">
            <div id="bomb-bar"></div>
          </div>
        </div>
      </div>
      <button id="pause-trigger" class="btn-hud" aria-label="Pause Game">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <rect x="5" y="4" width="4" height="16" rx="1"/>
          <rect x="15" y="4" width="4" height="16" rx="1"/>
        </svg>
      </button>
    </header>

    <div id="badge-tray"></div>

    <div id="start-curtain" class="overlay-curtain active">
      <div class="glass-slate">
        <h1 class="hero-title">CYBER<span style="color:var(--cyan)">NOVA</span></h1>
        <p class="hero-sub">HYPERDRIVE // PRO EDITION</p>
        <div class="briefing">
          <p><strong>MISSION DOSSIER:</strong> Cosmic deep-space interception protocol. Enemies descend on direct attack lines. 15 HP lost per impact or defense breach. Hull maximum capacity is 200 HP.</p>
          <div class="key-capsule">
            <div><kbd>A</kbd> / <kbd>←</kbd> <kbd>D</kbd> / <kbd>→</kbd> Pitch Maneuver</div>
            <div><kbd>SPACE</kbd> Plasma Blaster Battery</div>
            <div><kbd>C</kbd> EMP Hyper-Bomb (100% Gauge)</div>
            <div><kbd>P</kbd> Tactical Pause Matrix</div>
          </div>
        </div>
        <button id="launch-btn" class="cta-btn">INITIALIZE FLIGHT</button>
      </div>
    </div>

    <div id="pause-curtain" class="overlay-curtain">
      <div class="glass-slate" style="border-color:var(--purple)">
        <h2 class="hero-title" style="font-size:2.2rem; text-shadow:0 0 20px var(--purple)">PAUSED</h2>
        <p class="hero-sub">WARP GENERATOR IDLE</p>
        <div style="display:flex; flex-direction:column; gap:12px; margin-top:1.5rem;">
          <button id="resume-btn" class="cta-btn secondary-btn">RESUME ENGAGEMENT</button>
          <button id="restart-pause-btn" class="cta-btn danger-btn">ABORT & REBOOT</button>
        </div>
      </div>
    </div>

    <!-- Game Over Outro Panel -->
    <div id="gameover-curtain" class="overlay-curtain">
      <div class="glass-slate" id="gameover-card">
        <div id="best-score-banner" class="best-banner" style="display:none;">★ BEST SCORE ★</div>
        <div id="appreciation-statement" class="appreciation-card" style="display:none;"></div>

        <h2 id="gameover-title" class="hero-title" style="color:var(--magenta); text-shadow:0 0 25px var(--magenta)">KHATAM</h2>
        <p id="gameover-subtitle" class="hero-sub">HULL FRACTURE CRITICAL</p>

        <div class="score-matrix">
          <div class="hud-box">
            <span class="hud-tag">FINAL SCORE</span>
            <strong id="final-score" class="hud-num glow-cyan">0</strong>
          </div>
          <div class="hud-box">
            <span class="hud-tag">RECORD SCORE</span>
            <strong id="record-score" class="hud-num glow-gold">0</strong>
          </div>
        </div>
        <button id="reboot-btn" class="cta-btn">REDEPLOY INTERCEPTOR</button>
      </div>
    </div>

    <nav id="mobile-controls">
      <div class="dpad-cluster">
        <button id="btn-left" class="pad-btn" aria-label="Left">◄</button>
        <button id="btn-right" class="pad-btn" aria-label="Right">►</button>
      </div>
      <div class="action-cluster">
        <button id="btn-bomb" class="pad-btn bomb-trigger" aria-label="Bomb">EMP</button>
        <button id="btn-fire" class="pad-btn fire-trigger" aria-label="Fire">FIRE</button>
      </div>
    </nav>
  </div>

  <script>
    class ProAudioEngine {
      constructor() {
        this.ctx = null;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContext();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playWeaponShot(type) {
        if (!this.ctx) return;
        const t = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        if (type === 'minishot') {
          osc.type = 'square';
          osc.frequency.setValueAtTime(1400, t);
          osc.frequency.exponentialRampToValueAtTime(320, t + 0.05);
          gain.gain.setValueAtTime(0.08, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(t);
          osc.stop(t + 0.05);
          return;
        }

        if (type === 'shotgun') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(420, t);
          osc.frequency.exponentialRampToValueAtTime(50, t + 0.16);
          gain.gain.setValueAtTime(0.35, t);
          gain.gain.exponentialRampToValueAtTime(0.01, t + 0.16);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(t);
          osc.stop(t + 0.16);
          return;
        }

        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(920, t);
        osc.frequency.exponentialRampToValueAtTime(160, t + 0.1);
        gain.gain.setValueAtTime(0.18, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.1);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(t);
        osc.stop(t + 0.1);
      }

      playBombShockwave() {
        if (!this.ctx) return;
        const t = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(160, t);
        osc.frequency.exponentialRampToValueAtTime(25, t + 0.8);
        gain.gain.setValueAtTime(0.7, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.8);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(t);
        osc.stop(t + 0.8);
      }

      playExplosion(boss = false) {
        if (!this.ctx) return;
        const dur = boss ? 0.6 : 0.28;
        const buf = this.ctx.createBuffer(1, this.ctx.sampleRate * dur, this.ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;

        const noise = this.ctx.createBufferSource();
        noise.buffer = buf;
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(boss ? 380 : 750, this.ctx.currentTime);
        filter.frequency.linearRampToValueAtTime(40, this.ctx.currentTime + dur);

        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(boss ? 0.45 : 0.22, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + dur);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(this.ctx.destination);
        noise.start();
      }

      playPowerup(isHeal = false) {
        if (!this.ctx) return;
        const t = this.ctx.currentTime;
        const freqs = isHeal ? [261.6, 329.6, 392.0, 523.2] : [440, 554, 659, 880];
        freqs.forEach((f, i) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          const st = t + i * 0.04;
          osc.type = isHeal ? 'triangle' : 'sine';
          osc.frequency.setValueAtTime(f, st);
          gain.gain.setValueAtTime(0.18, st);
          gain.gain.exponentialRampToValueAtTime(0.001, st + 0.1);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(st);
          osc.stop(st + 0.1);
        });
      }

      playDefeatSound() {
        if (!this.ctx) return;
        const t = this.ctx.currentTime;
        [440, 370, 311, 207].forEach((f, i) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          const st = t + i * 0.14;
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(f, st);
          gain.gain.setValueAtTime(0.24, st);
          gain.gain.exponentialRampToValueAtTime(0.001, st + 0.18);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(st);
          osc.stop(st + 0.18);
        });
      }

      playHighscoreCelebration() {
        if (!this.ctx) return;
        const t = this.ctx.currentTime;
        [523.25, 659.25, 783.99, 1046.50, 1318.51].forEach((f, i) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          const st = t + i * 0.08;
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(f, st);
          gain.gain.setValueAtTime(0.2, st);
          gain.gain.exponentialRampToValueAtTime(0.001, st + 0.25);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(st);
          osc.stop(st + 0.25);
        });
      }
    }

    class NebulaCanvas {
      constructor(canvas) {
        this.canvas = canvas;
        this.ctx = canvas.getContext('2d');
        this.clouds = [];
        this.resize();
        this.init();
      }

      resize() {
        this.canvas.width = this.canvas.parentElement.clientWidth;
        this.canvas.height = this.canvas.parentElement.clientHeight;
      }

      init() {
        this.clouds = [
          { x: this.canvas.width * 0.25, y: this.canvas.height * 0.25, r: 260, color: 'rgba(0, 243, 255, 0.15)', vy: 16 },
          { x: this.canvas.width * 0.85, y: this.canvas.height * 0.65, r: 320, color: 'rgba(157, 0, 255, 0.14)', vy: 20 },
          { x: this.canvas.width * 0.45, y: this.canvas.height * 0.95, r: 280, color: 'rgba(255, 0, 85, 0.12)', vy: 14 }
        ];
      }

      render(dt) {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        for (let c of this.clouds) {
          c.y += c.vy * dt;
          if (c.y - c.r > this.canvas.height) {
            c.y = -c.r;
            c.x = Math.random() * this.canvas.width;
          }
          const g = this.ctx.createRadialGradient(c.x, c.y, 20, c.x, c.y, c.r);
          g.addColorStop(0, c.color);
          g.addColorStop(1, 'rgba(0,0,0,0)');
          this.ctx.fillStyle = g;
          this.ctx.beginPath();
          this.ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
          this.ctx.fill();
        }
      }
    }

    class StarfieldCanvas {
      constructor(canvas) {
        this.canvas = canvas;
        this.ctx = canvas.getContext('2d');
        this.stars = [];
        this.resize();
        this.init();
      }

      resize() {
        this.canvas.width = this.canvas.parentElement.clientWidth;
        this.canvas.height = this.canvas.parentElement.clientHeight;
      }

      init() {
        this.stars = [];
        for (let i = 0; i < 125; i++) {
          this.stars.push({
            x: Math.random() * this.canvas.width,
            y: Math.random() * this.canvas.height,
            size: Math.random() * 1.8 + 0.4,
            speed: Math.random() * 1.6 + 0.4,
            alpha: Math.random() * 0.7 + 0.3
          });
        }
      }

      render(dt) {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        for (let s of this.stars) {
          s.y += s.speed * (1 + dt * 2);
          if (s.y > this.canvas.height) {
            s.y = 0;
            s.x = Math.random() * this.canvas.width;
          }
          this.ctx.fillStyle = `rgba(255, 255, 255, ${s.alpha})`;
          this.ctx.beginPath();
          this.ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          this.ctx.fill();
        }
      }
    }

