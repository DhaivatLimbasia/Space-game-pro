        this.w = this.box.clientWidth;
        this.h = this.box.clientHeight;
        this.canvas.width = this.w;
        this.canvas.height = this.h;
        this.nebula.resize();
        this.starfield.resize();
        if (this.player) {
          this.player.y = this.h - 85;
        }
      }

      bootFlight() {
        this.audio.init();
        this.score = 0;
        this.sector = 1;
        this.bullets = [];
        this.enemies = [];
        this.drops = [];
        this.particles = [];
        this.floatingTexts = [];
        this.player.reset();

        this.gunDropTimer = 0;
        this.envShiftTimer = 0;
        this.envIndex = 0;
        this.box.className = 'sector-env-0';
        this.status = 'PLAYING';

        this.startCurtain.classList.remove('active');
        this.pauseCurtain.classList.remove('active');
        this.gameoverCurtain.classList.remove('active');

        this.updateHUD();
        this.lastT = performance.now();
      }

      togglePause() {
        if (this.status === 'PLAYING') {
          this.status = 'PAUSED';
          this.pauseCurtain.classList.add('active');
        } else if (this.status === 'PAUSED') {
          this.status = 'PLAYING';
          this.pauseCurtain.classList.remove('active');
          this.lastT = performance.now();
        }
      }

      terminateSession() {
        this.status = 'GAMEOVER';
        this.spawnFireball(this.player.x, this.player.y, '#00f3ff', 50);

        const isNewBest = this.score > this.highScore && this.score > 0;

        if (isNewBest) {
          // EXCLUSIVE BEST SCORE ROUTE: Never write fahhh, moye moye, or khatam
          this.highScore = this.score;
          localStorage.setItem('cybernova_pro_high', this.highScore);
          this.audio.playHighscoreCelebration();

          this.gameoverCard.style.borderColor = 'var(--gold)';
          this.gameoverTitle.textContent = "BEST SCORE";
          this.gameoverTitle.style.color = 'var(--gold)';
          this.gameoverTitle.style.textShadow = '0 0 25px rgba(255, 190, 11, 0.8)';
          this.gameoverSubtitle.textContent = "GALACTIC RECORD SHATTERED";

          const appreciationStatements = [
            "LEGENDARY ACE! Unstoppable interstellar command!",
            "GOD-TIER PILOTING! You shattered galactic records!",
            "SUPREME TACTICIAN! That run was pure perfection!",
            "ABSOLUTE MASTERCLASS! The sector salutes you!",
            "STELLAR DOMINANCE! You are unmatched in this universe!"
          ];
          const chosenStatement = appreciationStatements[Math.floor(Math.random() * appreciationStatements.length)];

          this.bestScoreBanner.style.display = 'inline-block';
          this.appreciationStatement.textContent = chosenStatement;
          this.appreciationStatement.style.display = 'block';
        } else {
          // NORMAL DEFEAT ROUTE: Randomly select only when best score is NOT achieved
          this.audio.playDefeatSound();
          const defeatPool = ['Khatam', 'fahhhhhh', 'Moye Moye'];
          const chosenDefeat = defeatPool[Math.floor(Math.random() * defeatPool.length)];

          this.gameoverCard.style.borderColor = 'var(--magenta)';
          this.gameoverTitle.textContent = chosenDefeat;
          this.gameoverTitle.style.color = 'var(--magenta)';
          this.gameoverTitle.style.textShadow = '0 0 25px rgba(255, 0, 85, 0.8)';
          this.gameoverSubtitle.textContent = "HULL FRACTURE CRITICAL";

          this.bestScoreBanner.style.display = 'none';
          this.appreciationStatement.style.display = 'none';
        }

        this.finalScore.textContent = this.score;
        this.recordScore.textContent = this.highScore;
        this.gameoverCurtain.classList.add('active');
      }

      shake(mag = 6) {
        this.shakeTime = 0.24;
        this.shakeMag = mag;
      }

      spawnHitMarker(x, y, txt, col) {
        this.floatingTexts.push(new FloatingText(x, y, txt, col));
      }

      spawnFireball(x, y, color, count = 20) {
        for (let i = 0; i < count; i++) {
          this.particles.push(new Spark(x, y, color));
        }
      }

      spawnAutomatedGunPod() {
        const arsenal = ['2shot', '3shot', '4shot', 'shotgun', 'minishot'];
        const choice = arsenal[Math.floor(Math.random() * arsenal.length)];
        const posX = Math.random() * (this.w - 90) + 45;
        this.drops.push(new TacticalPod(posX, -25, choice));
      }

      activateHyperBomb() {
        this.audio.playBombShockwave();
        this.shake(14);
        this.spawnHitMarker(this.w / 2, this.h / 2, 'EMP ORBITAL STRIKE!', '#bf82ff');

        for (let e of this.enemies) {
          if (!e.active) continue;
          e.active = false;
          this.spawnFireball(e.x, e.y, e.color, 30);
          this.score += e.score;
        }
        this.updateHUD();
      }

      applyPod(type) {
        if (type === 'hp_repair') {
          this.audio.playPowerup(true);
          this.player.heal(15, false);
          this.spawnHitMarker(this.player.x, this.player.y - 20, '+15 HP', '#05ffa1');
        } else if (type === 'hp_surge') {
          this.audio.playPowerup(true);
          this.player.heal(20, true);
          this.spawnHitMarker(this.player.x, this.player.y - 20, 'MAX HP EXPANDED', '#00ff88');
        } else {
          this.audio.playPowerup(false);
          this.player.setWeapon(type, 15);
          this.spawnHitMarker(this.player.x, this.player.y - 20, `${type.toUpperCase()} EQUIPPED`, '#00f3ff');
        }
        this.renderBadgeTray();
      }

      renderBadgeTray() {
        this.badgeTray.innerHTML = '';
        if (this.player.activeWeapon !== 'single' && this.player.weaponTimer > 0) {
          const pill = document.createElement('div');
          pill.className = 'badge-pill';
          pill.style.color = this.player.getGlowColor();

          let title = this.player.activeWeapon.toUpperCase();
          if (this.player.activeWeapon === '2shot') title = 'TWIN CANNON';
          if (this.player.activeWeapon === '3shot') title = 'TRIPLE SPREAD';
          if (this.player.activeWeapon === '4shot') title = 'QUAD BATTERY';
          if (this.player.activeWeapon === 'shotgun') title = 'SHOTGUN BLAST';
          if (this.player.activeWeapon === 'minishot') title = 'MINI GATLING';

          pill.innerHTML = `<span>${title}</span> <strong>${Math.ceil(this.player.weaponTimer)}s</strong>`;
          this.badgeTray.appendChild(pill);
        }
      }

      updateHUD() {
        this.scoreReadout.textContent = this.score;
        this.highScoreReadout.textContent = this.highScore;
        this.sectorReadout.textContent = this.sector;

        const hpRatio = Math.max(0, (this.player.hp / this.player.maxHp) * 100);
        this.healthBar.style.width = `${hpRatio}%`;
        this.hpCounter.textContent = `${Math.ceil(this.player.hp)} / ${this.player.maxHp}`;
        this.bombBar.style.width = `${this.player.bombCharge}%`;

        if (hpRatio > 50) this.hpCounter.style.color = 'var(--emerald)';
        else if (hpRatio > 25) this.hpCounter.style.color = 'var(--gold)';
        else this.hpCounter.style.color = 'var(--magenta)';
      }

      checkCollisions() {
        for (let b of this.bullets) {
          if (!b.active) continue;
          for (let e of this.enemies) {
            if (!e.active) continue;

            if (
              b.x + b.w / 2 > e.x - e.w / 2 &&
              b.x - b.w / 2 < e.x + e.w / 2 &&
              b.y < e.y + e.h / 2 &&
              b.y + b.h > e.y - e.h / 2
            ) {
              b.active = false;

              if (this.sector <= 3) {
                e.hp = 0;
              } else {
                e.hp -= b.damage;
              }

              this.spawnFireball(b.x, b.y, b.color, 4);

              if (e.hp <= 0) {
                e.active = false;
                this.audio.playExplosion(e.type === 'dreadnought');
                this.spawnFireball(e.x, e.y, e.color, e.type === 'dreadnought' ? 36 : 18);
                this.score += e.score;
                this.player.addBombEnergy(e.type === 'dreadnought' ? 14 : 6);

                const newSector = Math.floor(this.score / 1500) + 1;
                if (newSector !== this.sector) {
                  this.sector = newSector;
                  this.spawnHitMarker(this.w / 2, this.h / 2, `SECTOR ${this.sector} REACHED!`, '#9d00ff');
                }

                this.updateHUD();

                if (Math.random() < 0.12) {
                  const hpType = Math.random() < 0.8 ? 'hp_repair' : 'hp_surge';
                  this.drops.push(new TacticalPod(e.x, e.y, hpType));
                }
              }
              break;
            }
          }
        }

        for (let e of this.enemies) {
          if (!e.active) continue;
          const dist = Math.hypot(e.x - this.player.x, e.y - this.player.y);
          if (dist < (e.w + this.player.w) / 2.6) {
            e.active = false;
            this.audio.playExplosion(true);
            this.spawnFireball(e.x, e.y, e.color, 25);
            this.player.takeDamage(15);
          }
        }

        for (let d of this.drops) {
          if (!d.active) continue;
          const dist = Math.hypot(d.x - this.player.x, d.y - this.player.y);
          if (dist < d.r + this.player.w / 2) {
            d.active = false;
            this.applyPod(d.skillType);
          }
        }
      }

      update(dt) {
        this.nebula.render(dt);
        this.starfield.render(dt);

        if (this.status !== 'PLAYING') return;

        if (this.shakeTime > 0) this.shakeTime -= dt;

        this.envShiftTimer += dt;
        if (this.envShiftTimer >= 15.0) {
          this.envIndex = (this.envIndex + 1) % 4;
          this.box.className = `sector-env-${this.envIndex}`;
          this.envShiftTimer = 0;
        }

        this.player.update(dt, this.input);
        this.renderBadgeTray();

        this.gunDropTimer += dt;
        if (this.gunDropTimer >= 5.0) {
          this.spawnAutomatedGunPod();
          this.gunDropTimer = 0;
        }

        const cadence = Math.max(0.42, 1.35 - (this.sector - 1) * 0.12);
        this.spawnTimer += dt;
        if (this.spawnTimer >= cadence) {
          const rand = Math.random();
          let t = 'scout';
          if (this.sector >= 3 && rand < 0.22) t = 'dreadnought';
          else if (this.sector >= 2 && rand < 0.6) t = 'fighter';
          this.enemies.push(new ProEnemy(this, t));
          this.spawnTimer = 0;
        }

        this.bullets.forEach(b => b.update(dt));
        this.enemies.forEach(e => e.update(dt));
        this.drops.forEach(d => d.update(dt));
        this.particles.forEach(p => p.update(dt));
        this.floatingTexts.forEach(t => t.update(dt));

        this.checkCollisions();

        this.bullets = this.bullets.filter(b => b.active);
        this.enemies = this.enemies.filter(e => e.active);
        this.drops = this.drops.filter(d => d.active);
        this.particles = this.particles.filter(p => p.alpha > 0);
        this.floatingTexts = this.floatingTexts.filter(t => t.alpha > 0);
      }

      render() {
        this.ctx.clearRect(0, 0, this.w, this.h);

        this.ctx.save();
        if (this.shakeTime > 0) {
          const ox = (Math.random() * 2 - 1) * this.shakeMag;
          const oy = (Math.random() * 2 - 1) * this.shakeMag;
          this.ctx.translate(ox, oy);
        }

        this.particles.forEach(p => p.draw(this.ctx));
        this.drops.forEach(d => d.draw(this.ctx));
        this.bullets.forEach(b => b.draw(this.ctx));
        this.enemies.forEach(e => e.draw(this.ctx));

        if (this.status === 'PLAYING' || this.status === 'PAUSED') {
          this.player.draw(this.ctx);
        }

        this.floatingTexts.forEach(t => t.draw(this.ctx));

        this.ctx.restore();
      }

      renderLoop(timestamp) {
        if (!this.lastT) this.lastT = timestamp;
        const dt = Math.min((timestamp - this.lastT) / 1000, 0.1);
        this.lastT = timestamp;

        this.update(dt);
        this.render();

        requestAnimationFrame(this.renderLoop.bind(this));
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      new ProGameController();
    });
  </script>
</body>
