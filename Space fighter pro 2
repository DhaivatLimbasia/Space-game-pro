    class ProPlayer {
      constructor(game) {
        this.game = game;
        this.w = 52;
        this.h = 52;
        this.x = game.w / 2;
        this.y = game.h - 85;
        this.speed = 460;

        this.maxHp = 100;
        this.hp = 100;

        this.activeWeapon = 'single';
        this.weaponTimer = 0;
        this.fireTimer = 0;
        this.droneAngle = 0;

        this.tilt = 0;
        this.bombCharge = 0;
      }

      reset() {
        this.x = this.game.w / 2;
        this.y = this.game.h - 85;
        this.maxHp = 100;
        this.hp = 100;
        this.activeWeapon = 'single';
        this.weaponTimer = 0;
        this.fireTimer = 0;
        this.tilt = 0;
        this.bombCharge = 0;
      }

      setWeapon(type, duration = 15) {
        this.activeWeapon = type;
        this.weaponTimer = duration;
      }

      heal(amount, boostMax = false) {
        if (boostMax) {
          this.maxHp = Math.min(200, this.maxHp + 10);
        }
        this.hp = Math.min(this.maxHp, this.hp + amount);
        this.game.updateHUD();
      }

      addBombEnergy(amount) {
        this.bombCharge = Math.min(100, this.bombCharge + amount);
        this.game.updateHUD();
      }

      triggerBomb() {
        if (this.bombCharge >= 100) {
          this.bombCharge = 0;
          this.game.activateHyperBomb();
        }
      }

      update(dt, input) {
        let movingLeft = input.left;
        let movingRight = input.right;

        if (movingLeft) {
          this.x -= this.speed * dt;
          this.tilt = Math.max(-0.28, this.tilt - dt * 2.8);
        } else if (movingRight) {
          this.x += this.speed * dt;
          this.tilt = Math.min(0.28, this.tilt + dt * 2.8);
        } else {
          this.tilt *= 0.85;
        }

        const half = this.w / 2;
        if (this.x - half < 10) this.x = 10 + half;
        if (this.x + half > this.game.w - 10) this.x = this.game.w - 10 - half;

        if (this.weaponTimer > 0) {
          this.weaponTimer -= dt;
          if (this.weaponTimer <= 0) {
            this.activeWeapon = 'single';
            this.weaponTimer = 0;
          }
        }

        this.droneAngle += dt * 3.5;

        let cd = 0.22;
        if (this.activeWeapon === 'minishot') cd = 0.08;
        if (this.activeWeapon === 'shotgun') cd = 0.42;
        if (this.activeWeapon === '4shot') cd = 0.28;

        this.fireTimer += dt;
        if (input.fire && this.fireTimer >= cd) {
          this.fire();
          this.fireTimer = 0;
        }
      }

      fire() {
        this.game.audio.playWeaponShot(this.activeWeapon);

        switch (this.activeWeapon) {
          case '2shot':
            this.game.bullets.push(new ProBullet(this.x - 14, this.y - 14, 0, -840, '#00f3ff', 4, 18, 1));
            this.game.bullets.push(new ProBullet(this.x + 14, this.y - 14, 0, -840, '#00f3ff', 4, 18, 1));
            break;

          case '3shot':
            this.game.bullets.push(new ProBullet(this.x, this.y - 20, 0, -860, '#ffbe0b', 5, 20, 1.2));
            this.game.bullets.push(new ProBullet(this.x - 12, this.y - 10, -180, -800, '#ffbe0b', 4, 16, 1));
            this.game.bullets.push(new ProBullet(this.x + 12, this.y - 10, 180, -800, '#ffbe0b', 4, 16, 1));
            break;

          case '4shot':
            this.game.bullets.push(new ProBullet(this.x - 22, this.y - 6, -60, -880, '#9d00ff', 4, 18, 1.3));
            this.game.bullets.push(new ProBullet(this.x - 8, this.y - 16, 0, -900, '#9d00ff', 5, 20, 1.3));
            this.game.bullets.push(new ProBullet(this.x + 8, this.y - 16, 0, -900, '#9d00ff', 5, 20, 1.3));
            this.game.bullets.push(new ProBullet(this.x + 22, this.y - 6, 60, -880, '#9d00ff', 4, 18, 1.3));
            break;

          case 'shotgun':
            this.game.shake(5);
            [-260, -150, -50, 50, 150, 260].forEach(vx => {
              this.game.bullets.push(new ProBullet(this.x, this.y - 18, vx, -750, '#ff5e00', 6, 11, 1.8));
            });
            break;

          case 'minishot':
            const jit = (Math.random() - 0.5) * 70;
            this.game.bullets.push(new ProBullet(this.x, this.y - 20, jit, -1040, '#05ffa1', 3, 11, 0.8));
            break;

          default:
            this.game.bullets.push(new ProBullet(this.x, this.y - 22, 0, -800, '#00f3ff', 4, 18, 1));
            break;
        }

        const dx = this.x + Math.cos(this.droneAngle) * 38;
        const dy = this.y + Math.sin(this.droneAngle) * 22;
        this.game.bullets.push(new ProBullet(dx, dy, 0, -850, '#00f3ff', 2.5, 9, 0.4));
      }

      takeDamage(dmg = 15) {
        this.hp = Math.max(0, this.hp - dmg);
        this.game.shake(10);
        this.game.spawnHitMarker(this.x, this.y, `-${dmg} HP`, '#ff0055');
        this.game.updateHUD();
        if (this.hp <= 0) {
          this.game.terminateSession();
        }
      }

      draw(ctx) {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.tilt);

        const flk = Math.random() * 10 + 15;
        const thrusterGrad = ctx.createLinearGradient(0, 16, 0, 16 + flk);
        thrusterGrad.addColorStop(0, '#00f3ff');
        thrusterGrad.addColorStop(0.5, '#9d00ff');
        thrusterGrad.addColorStop(1, 'transparent');
        ctx.fillStyle = thrusterGrad;
        ctx.fillRect(-12, 16, 6, flk);
        ctx.fillRect(6, 16, 6, flk);

        ctx.fillStyle = '#0a1024';
        ctx.strokeStyle = this.getGlowColor();
        ctx.lineWidth = 2.2;
        ctx.shadowColor = this.getGlowColor();
        ctx.shadowBlur = 10;

        ctx.beginPath();
        ctx.moveTo(0, -26);
        ctx.lineTo(24, 16);
        ctx.lineTo(12, 14);
        ctx.lineTo(0, 20);
        ctx.lineTo(-12, 14);
        ctx.lineTo(-24, 16);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = this.getGlowColor();
        ctx.beginPath();
        ctx.ellipse(0, -4, 4.5, 11, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();

        const droneX = this.x + Math.cos(this.droneAngle) * 38;
        const droneY = this.y + Math.sin(this.droneAngle) * 22;
        ctx.save();
        ctx.translate(droneX, droneY);
        ctx.fillStyle = '#05ffa1';
        ctx.shadowColor = '#05ffa1';
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.arc(0, 0, 4.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      getGlowColor() {
        switch (this.activeWeapon) {
          case '2shot': return '#00f3ff';
          case '3shot': return '#ffbe0b';
          case '4shot': return '#9d00ff';
          case 'shotgun': return '#ff5e00';
          case 'minishot': return '#05ffa1';
          default: return '#00f3ff';
        }
      }
    }

    class ProBullet {
      constructor(x, y, vx, vy, color, width, height, damage = 1) {
        this.x = x;
        this.y = y;
        this.vx = vx;
        this.vy = vy;
        this.color = color;
        this.w = width;
        this.h = height;
        this.damage = damage;
        this.active = true;
      }

      update(dt) {
        this.x += this.vx * dt;
        this.y += this.vy * dt;
        if (this.y < -30 || this.x < -30 || this.x > 900) this.active = false;
      }

      draw(ctx) {
        ctx.save();
        ctx.fillStyle = this.color;
        ctx.shadowColor = this.color;
        ctx.shadowBlur = 8;
        ctx.fillRect(this.x - this.w / 2, this.y, this.w, this.h);
        ctx.restore();
      }
    }

    class ProEnemy {
      constructor(game, type) {
        this.game = game;
        this.type = type;
        this.active = true;

        if (type === 'scout') {
          this.w = 32;
          this.h = 28;
          this.hp = 1.2;
          this.maxHp = 1.2;
          this.speed = 190 + Math.random() * 40;
          this.score = 100;
          this.color = '#ffbe0b';
        } else if (type === 'fighter') {
          this.w = 44;
          this.h = 38;
          this.hp = 3.5;
          this.maxHp = 3.5;
          this.speed = 135 + Math.random() * 30;
          this.score = 250;
          this.color = '#ff0055';
        } else {
          this.w = 66;
          this.h = 56;
          this.hp = 9;
          this.maxHp = 9;
          this.speed = 75 + Math.random() * 20;
          this.score = 600;
          this.color = '#9d00ff';
        }

        if (this.game.sector <= 3) {
          this.hp = 1;
          this.maxHp = 1;
        }

        this.x = Math.random() * (game.w - this.w - 50) + (this.w / 2 + 25);
        this.y = -this.h;
      }

      update(dt) {
        this.y += this.speed * dt;

        if (this.y - this.h / 2 > this.game.h) {
          this.active = false;
          this.game.player.takeDamage(15);
        }
      }

      draw(ctx) {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.fillStyle = '#0b0f1d';
        ctx.strokeStyle = this.color;
        ctx.lineWidth = 2.2;
        ctx.shadowColor = this.color;
        ctx.shadowBlur = 9;

        if (this.type === 'scout') {
          ctx.beginPath();
          ctx.moveTo(0, 15);
          ctx.lineTo(15, -15);
          ctx.lineTo(-15, -15);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        } else if (this.type === 'fighter') {
          ctx.beginPath();
          ctx.moveTo(0, 20);
          ctx.lineTo(20, -6);
          ctx.lineTo(14, -18);
          ctx.lineTo(0, -10);
          ctx.lineTo(-14, -18);
          ctx.lineTo(-20, -6);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        } else {
          ctx.beginPath();
          ctx.moveTo(0, 26);
          ctx.lineTo(32, 0);
          ctx.lineTo(22, -26);
          ctx.lineTo(-22, -26);
          ctx.lineTo(-32, 0);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        }

        if (this.maxHp > 1.5 && this.hp < this.maxHp) {
          const barW = this.w;
          ctx.shadowBlur = 0;
          ctx.fillStyle = 'rgba(255,255,255,0.2)';
          ctx.fillRect(-barW / 2, -this.h / 2 - 8, barW, 4);
          ctx.fillStyle = this.color;
          ctx.fillRect(-barW / 2, -this.h / 2 - 8, Math.max(0, (barW * this.hp) / this.maxHp), 4);
        }

        ctx.restore();
      }
    }

